{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clipwright Studio",
  "version": "0.1.0",
  "identifier": "site.clipwright.studio",
  "build": {
    "beforeDevCommand": "bun run vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Clipwright Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 720,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#0b0d10"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/sources/*.mp4",
          "**/sources/*.mov",
          "**/sources/*.webm",
          "**/sources/*.m4v",
          "**/sources/panels/**/*.webp",
          "**/sources/panels/**/*.png",
          "**/sources/panels/**/*.jpg",
          "**/sources/panels/**/*.jpeg",
          "**/out/segments/**/*.mp4",
          "**/out/final/*.mp4",
          "**/out/final.mp4",
          "**/captions/**/*.png"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
